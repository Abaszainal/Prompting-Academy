# Copy to .env and fill in. Never commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Who you are ---
COMPANY_NAME=Your Company Name
SIGNATURE_NAME=Customer Enquiries Team
ESCALATION_EMAIL=zainal@evocoleadership.com
AGENT_EMAIL=enquiry@yourdomain.com

# --- Inbox the agent reads (IMAP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Outgoing mail (SMTP with STARTTLS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Behaviour ---
# Leave DRY_RUN=true until you have checked decisions.jsonl and are happy with the routing.
DRY_RUN=true
CONFIDENCE_THRESHOLD=0.8
MAX_AUTO_REPLIES_PER_SENDER_PER_DAY=2
ACK_ON_ESCALATION=true
POLL_SECONDS=120
